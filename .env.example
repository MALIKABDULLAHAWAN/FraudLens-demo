# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./fraudlens.db
# PostgreSQL (uncomment for docker-compose or production):
# DATABASE_URL=postgresql://fraudlens:fraudlens@db:5432/fraudlens

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── ML ──────────────────────────────────────────────────────────────────────
MODEL_PATH=artifacts/xgb_model.joblib
FRAUD_THRESHOLD=0.5   # override at runtime without retraining

# ─── LLM (optional) ──────────────────────────────────────────────────────────
# Local Ollama:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# OpenAI-compatible hosted endpoint (e.g. Together AI, Anyscale):
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct-Turbo

LLM_TIMEOUT=8          # seconds; falls back to template on timeout

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development   # development | production
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ─── Prometheus ──────────────────────────────────────────────────────────────
METRICS_ENABLED=true
